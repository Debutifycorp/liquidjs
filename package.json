{
  "name": "@debutify/liquidjs",
  "version": "0.1.0",
  "sideEffects": false,
  "description": "Debutify's fork of LiquidJS with Shopify Liquid semantics, for rendering Shopify themes outside Shopify.",
  "upstreamLiquidjs": "10.30.0",
  "packageManager": "pnpm@12.11.2",
  "main": "dist/liquid.node.js",
  "module": "dist/liquid.node.mjs",
  "es2015": "dist/liquid.browser.mjs",
  "browser": {
    "./dist/liquid.node.js": "./dist/liquid.browser.umd.js",
    "./dist/liquid.node.mjs": "./dist/liquid.browser.mjs"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/liquid.browser.mjs",
        "require": "./dist/liquid.browser.umd.js"
      },
      "module": "./dist/liquid.node.mjs",
      "default": "./dist/liquid.node.js"
    },
    "./shopify": {
      "types": "./dist/shopify/index.d.ts",
      "module": "./dist/shopify.node.mjs",
      "default": "./dist/shopify.node.js"
    },
    "./dist/*": {
      "types": [
        "./dist/*.d.ts",
        "./dist/*/index.d.ts",
        "./dist/*"
      ],
      "default": "./dist/*"
    },
    "./bin/liquid.js": "./bin/liquid.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "shopify": [
        "dist/shopify/index.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "lint": "eslint \"**/*.mjs\" \"**/*.ts\" .",
    "check": "npm run build && npm run build:docs && npm test && npm run lint && npm run perf:diff",
    "test": "jest",
    "test:coverage": "jest --coverage src test/integration",
    "test:e2e": "jest test/e2e",
    "test:demo": "./test/demo/test.sh",
    "perf:diff": "node bin/perf-diff.js",
    "perf:engines": "cd benchmark && npm run engines",
    "version": "npm run build && npm test",
    "build": "rollup -c rollup.config.mjs",
    "build:cjs": "BUNDLES=cjs rollup -c rollup.config.mjs",
    "build:min": "BUNDLES=min rollup -c rollup.config.mjs",
    "build:umd": "BUNDLES=umd rollup -c rollup.config.mjs",
    "build:charmap": "./bin/character-gen.js > src/util/character.ts",
    "build:shopify-registry": "node bin/shopify-filter-registry.js",
    "prepare:docs": "run-s build:docs-liquid build:contributors build:apidoc build:changelog",
    "build:docs": "run-s prepare:docs build:docs-hexo",
    "build:docs-liquid": "cross-env BUNDLES=min rollup -c rollup.config.mjs && shx cp dist/liquid.browser.min.js docs/themes/navy/source/js/",
    "build:contributors": "node bin/build-contributors.js",
    "build:apidoc": "shx rm -rf docs/source/api && typedoc --plugin typedoc-plugin-missing-exports ./src --gitRevision master --out docs/source/api",
    "build:changelog": "node bin/build-changelog.js",
    "build:docs-hexo": "cd docs && npm ci && npm run build && shx cp CNAME .nojekyll public/",
    "serve:docs": "cd docs && npm run start",
    "dev:docs": "run-s prepare:docs serve:docs"
  },
  "bin": {
    "liquidjs": "bin/liquid.js",
    "liquid": "bin/liquid.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debutifycorp/liquidjs.git"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/liquidjs"
  },
  "files": [
    "bin/liquid.js",
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "keywords": [
    "liquid",
    "template engine",
    "express",
    "jinja",
    "shopify"
  ],
  "author": "Harttle",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Debutifycorp/liquidjs/issues"
  },
  "homepage": "https://github.com/Debutifycorp/liquidjs#readme",
  "devDependencies": {
    "@commitlint/cli": "^12.1.4",
    "@commitlint/config-conventional": "^8.2.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/benchmark": "^1.0.31",
    "@types/express": "^4.17.2",
    "@types/jest": "^29.4.0",
    "@types/jsdom": "^12.2.2",
    "@types/node": "^22.3.0",
    "@types/sinon": "^10.0.13",
    "@types/supertest": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "^5.6.0",
    "benchmark": "^2.1.4",
    "cross-env": "^5.2.0",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-deprecation": "^1.3.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-mocha": "^5.3.0",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0",
    "express": "^4.16.4",
    "jest": "^29.5.0",
    "jsdom": "^16.5.0",
    "npm-run-all2": "^8.0.4",
    "rollup": "^4.64.5",
    "rollup-plugin-typescript2": "^0.37.0",
    "semantic-release": "^25.0.9",
    "shx": "^0.4.0",
    "sinon": "^15.0.2",
    "supertest": "^3.4.2",
    "ts-jest": "^29.0.5",
    "tslib": "^2.3.1",
    "typedoc": "^0.26.5",
    "typedoc-plugin-missing-exports": "^3.0.0",
    "typescript": "^4.5.3"
  },
  "dependencies": {
    "commander": "^10.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nyc": {
    "extension": [
      ".ts"
    ]
  }
}
