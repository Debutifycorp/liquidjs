{
  "compilerOptions": {
    "target": "es6",
    "module":"CommonJS",
    "lib": ["es2015", "es2016", "es2017", "es2018.intl", "dom"],
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node", "jest"]
  },
  "all": true,
  "exclude": [ "node_modules", "dist", "demo", "test" ]
}
