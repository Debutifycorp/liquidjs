{%- layout none -%}
{%- capture contact -%}{%- form 'contact' -%}{"posted_successfully":{{ form.posted_successfully? | json }},"errors":[{%- for field in form.errors -%}{"field":{{ field | json }},"message":{{ form.errors.messages[field] | json }},"translated":{{ form.errors.translated_fields[field] | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"email":{{ form.email | json }},"body":{{ form.body | json }},"name":{{ form.name | json }}}{%- endform -%}{%- endcapture -%}
{%- capture newsletter -%}{%- form 'customer' -%}{"posted_successfully":{{ form.posted_successfully? | json }},"errors":[{%- for field in form.errors -%}{"field":{{ field | json }},"message":{{ form.errors.messages[field] | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"email":{{ form.email | json }}}{%- endform -%}{%- endcapture -%}
{"contact":{{ contact | split: '>' | last | split: '<input' | first | default: '{}' }},"customer":{{ newsletter | split: '>' | last | split: '<input' | first | default: '{}' }},"contact_form":{{ contact | json }},"customer_form":{{ newsletter | json }}}
