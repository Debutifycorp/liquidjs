{%- layout none -%}
{%- capture filters -%}
{%- for f in search.filters -%}
{"label":{{ f.label | json }},"type":{{ f.type | json }},"param_name":{{ f.param_name | json }},"active_values":[{%- for v in f.active_values -%}{{ v.value | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"values":[{%- for v in f.values -%}{"value":{{ v.value | json }},"count":{{ v.count | json }},"active":{{ v.active | json }},"url_to_add":{{ v.url_to_add | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
{%- endcapture -%}
{"performed":{{ search.performed | json }},"terms":{{ search.terms | json }},"types":{{ search.types | json }},"results_count":{{ search.results_count | json }},
"results":[{%- for r in search.results -%}{"object_type":{{ r.object_type | json }},"handle":{{ r.handle | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"sort_by":{{ search.sort_by | json }},"default_sort_by":{{ search.default_sort_by | json }},"sort_options":[{%- for o in search.sort_options -%}{"name":{{ o.name | json }},"value":{{ o.value | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"filters":[{{ filters }}]}
