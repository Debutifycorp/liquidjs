{%- layout none -%}
{%- capture localization_form -%}{%- form 'localization' -%}{%- endform -%}{%- endcapture -%}
{%- capture product_form -%}{%- form 'product', all_products['hoodie'] -%}{%- endform -%}{%- endcapture -%}
{"localization":{
"country":{"iso_code":{{ localization.country.iso_code | json }},"name":{{ localization.country.name | json }},"currency":{{ localization.country.currency.iso_code | json }},"symbol":{{ localization.country.currency.symbol | json }}},
"language":{"iso_code":{{ localization.language.iso_code | json }},"name":{{ localization.language.name | json }},"endonym_name":{{ localization.language.endonym_name | json }},"root_url":{{ localization.language.root_url | json }},"primary":{{ localization.language.primary | json }}},
"market":{"handle":{{ localization.market.handle | json }}},
"available_countries":[{%- for c in localization.available_countries -%}{"iso_code":{{ c.iso_code | json }},"name":{{ c.name | json }},"currency":{{ c.currency.iso_code | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"available_languages":[{%- for l in localization.available_languages -%}{"iso_code":{{ l.iso_code | json }},"root_url":{{ l.root_url | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]},
"routes":{"root_url":{{ routes.root_url | json }},"cart_url":{{ routes.cart_url | json }},"cart_add_url":{{ routes.cart_add_url | json }},"cart_change_url":{{ routes.cart_change_url | json }},"cart_update_url":{{ routes.cart_update_url | json }},"cart_clear_url":{{ routes.cart_clear_url | json }},"collections_url":{{ routes.collections_url | json }},"all_products_collection_url":{{ routes.all_products_collection_url | json }},"search_url":{{ routes.search_url | json }},"predictive_search_url":{{ routes.predictive_search_url | json }},"product_recommendations_url":{{ routes.product_recommendations_url | json }},"account_url":{{ routes.account_url | json }},"account_login_url":{{ routes.account_login_url | json }}},
"request":{"path":{{ request.path | json }},"host":{{ request.host | json }},"page_type":{{ request.page_type | json }},"locale":{{ request.locale.iso_code | json }},"locale_root_url":{{ request.locale.root_url | json }}},
"shop":{"name":{{ shop.name | json }},"description":{{ shop.description | json }},"currency":{{ shop.currency | json }},"enabled_currencies":[{%- for c in shop.enabled_currencies -%}{{ c.iso_code | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"published_locales":[{%- for l in shop.published_locales -%}{"iso_code":{{ l.iso_code | json }},"root_url":{{ l.root_url | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]},
"cart_currency":{{ cart.currency.iso_code | json }},"money":{{ 1999 | money | json }},"money_with_currency":{{ 1999 | money_with_currency | json }},
"product":{"title":{{ all_products['hoodie'].title | json }},"url":{{ all_products['hoodie'].url | json }},"price":{{ all_products['hoodie'].price | json }}},
"collection":{"title":{{ collections.tops.title | json }},"url":{{ collections.tops.url | json }}},
"page":{"title":{{ page.title | json }},"content":{{ page.content | json }},"template_suffix":{{ page.template_suffix | json }}},
"menu":[{%- for l in linklists['main-menu'].links -%}{"title":{{ l.title | json }},"url":{{ l.url | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"canonical_url":{{ canonical_url | json }},"template":{"name":{{ template.name | json }},"suffix":{{ template.suffix | json }}},
"localization_form":{{ localization_form | json }},"product_form":{{ product_form | json }}}
